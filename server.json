{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.palrajjp/agentramen",
  "title": "agentRamen",
  "description": "Local-first codebase intelligence for coding agents: indexes code and Git history into SQLite.",
  "repository": {
    "url": "https://github.com/palrajjp/agentRamen",
    "source": "github"
  },
  "version": "0.2.5",
  "packages": [
    {
      "registryType": "pypi",
      "registryBaseUrl": "https://pypi.org",
      "identifier": "agentramen",
      "version": "0.2.5",
      "transport": { "type": "stdio" },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp",
          "description": "Start the agentRamen MCP stdio server"
        }
      ]
    }
  ]
}